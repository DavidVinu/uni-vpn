{
  "manifest_version": 3,
  "name": "Uni VPN",
  "version": "0.1.0",
  "description": "Gelistete Uni-Domains laufen ueber den lokalen uni-vpn-Proxy, alles andere direkt.",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uni VPN",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "uni-vpn@davidvinu.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
