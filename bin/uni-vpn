#!/usr/bin/env python3
"""Entry point for uni-vpn. Finds the package relative to this file."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

if __name__ == "__main__":
    from uni_vpn.handover import handover

    code = handover(ROOT, sys.argv[1:])
    if code is not None:
        sys.exit(code)

if sys.version_info < (3, 11):
    sys.exit("uni-vpn needs Python 3.11 or newer")

from uni_vpn.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
