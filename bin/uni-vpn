#!/usr/bin/env python3
"""Entry point for uni-vpn. Finds the package relative to this file."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

from uni_vpn.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
