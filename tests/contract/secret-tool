#!/usr/bin/env python3
"""Stand-in for libsecret's secret-tool: one file per attribute set in $FAKE_KEYRING_DIR."""
import hashlib
import json
import os
import sys
from pathlib import Path


def entry(attrs):
    key = json.dumps(sorted(zip(attrs[::2], attrs[1::2])))
    return Path(os.environ["FAKE_KEYRING_DIR"]) / hashlib.sha256(key.encode()).hexdigest()


def main():
    args = sys.argv[1:]
    command, rest = args[0], args[1:]
    if command == "store":
        label = ""
        if rest[:1] == ["--label"]:
            label, rest = rest[1], rest[2:]
        elif rest and rest[0].startswith("--label="):
            label, rest = rest[0].split("=", 1)[1], rest[1:]
        entry(rest).write_text(json.dumps({"label": label, "attrs": rest, "secret": sys.stdin.read()}))
        return 0
    path = entry(rest)
    if command == "lookup":
        if not path.exists():
            return 1
        sys.stdout.write(json.loads(path.read_text())["secret"])
        return 0
    if command == "clear":
        if path.exists():
            path.unlink()
        return 0
    return 2


sys.exit(main())
