<?xml version="1.0" encoding="utf-8"?>
<!-- The download page's build updates itself (ApkUpdate): Android's installer, after asking. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12 and later: once this app installed itself, later updates need no question
         (ApkUpdate.install asks for that). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- The installer's answer; not exported, so only it can send one. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
